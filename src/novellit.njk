---
layout: base.njk
title: Novellit | Kirjallisuussivusto
---
<section id="novellit">
  <h1 style="font-size: 2.5rem; margin-bottom: 2rem;">Novellit</h1>
  
  {%- for post in collections.novellit -%}
    <a href="{{ post.url }}" class="story-link">
      <h3 class="story-title">{{ post.data.title }}</h3>
      <div class="story-meta">{{ post.date | date }} &bull; Lyhyttarina</div>
    </a>
  {%- else -%}
    <p>Ei novelleja vielä julkaistu.</p>
  {%- endfor -%}
</section>
